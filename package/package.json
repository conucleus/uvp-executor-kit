{
  "name": "@uvp-eth/executor-kit",
  "version": "0.1.0",
  "private": true,
  "description": "CLI and SDK for UVP EVM executors, executors, and adjudicators.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "uvp-executor": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts",
    "./participant": "./src/participant/index.ts",
    "./participant/evm": "./src/participant/evm.ts",
    "./participant/solana": "./src/participant/solana.ts"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@uvp-eth/protocol-bindings": "workspace:*",
    "commander": "^12.1.0",
    "viem": "^2.21.58"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
